{
  "name": "dsh-remote",
  "version": "0.5.0",
  "description": "SSH remote-server operations for DeepSeek Harness: host discovery from ~/.ssh/config, remote command execution, SFTP file tools, and Crescent-style command risk review with approval gating.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin/dsh-remote-terminal",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/icon.svg",
    "docs/assets/management-page.png",
    "docs/assets/remote-terminal.png"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "remote-server",
    "operations",
    "sftp"
  ],
  "icon": "./docs/icon.svg",
  "license": "MIT",
  "author": "aide-family",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aide-family/dsh-remote.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "test": "node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dev:profile": "bash scripts/dev-profile.sh",
    "dev:sync": "bash scripts/sync-profile.sh",
    "pack:plugin": "mkdir -p dist && npm pack --pack-destination dist",
    "install:profile": "bash scripts/install-into-profile.sh",
    "dev:screenshot": "node scripts/dev-screenshot.mjs",
    "dev:web": "node scripts/dev-web-test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "playwright-core": "^1.64.1"
  }
}
